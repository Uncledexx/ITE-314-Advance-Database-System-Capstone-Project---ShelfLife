
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShelfLife - My Pantry</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('../partials/header') %>

    <main class="container">
        <section class="panel">
            <h1>My Pantry</h1>
            <p class="muted">Manage your food items and expiration dates.</p>

            <a class="button" href="/pantry/add">+ Add Food</a>
        </section>

        <!-- Search, filter, and sort -->
        <section class="panel">
            <h2>Find Pantry Items</h2>

            <form action="/pantry" method="GET">
                <div class="form-group">
                    <label for="search">Search food name</label>
                    <input
                        type="search"
                        id="search"
                        name="search"
                        placeholder="Example: Milk"
                        value="<%= filters.search %>"
                    >
                </div>

                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category" name="category">
                        <option value="">All Categories</option>

                        <% categories.forEach(category => { %>
                            <option
                                value="<%= category.id %>"
                                <%= String(filters.categoryId) === String(category.id) ? 'selected' : '' %>
                            >
                                <%= category.name %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="status">Expiration Status</label>
                    <select id="status" name="status">
                        <option value="" <%= filters.status === '' ? 'selected' : '' %>>
                            All Statuses
                        </option>

                        <option value="available" <%= filters.status === 'available' ? 'selected' : '' %>>
                            Available
                        </option>

                        <option value="expiring" <%= filters.status === 'expiring' ? 'selected' : '' %>>
                            Expiring Soon
                        </option>

                        <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>
                            Expired
                        </option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="sort">Sort By</label>
                    <select id="sort" name="sort">
                        <option value="expiration_asc" <%= filters.sort === 'expiration_asc' ? 'selected' : '' %>>
                            Expiration Date (Soonest First)
                        </option>

                        <option value="expiration_desc" <%= filters.sort === 'expiration_desc' ? 'selected' : '' %>>
                            Expiration Date (Latest First)
                        </option>

                        <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>
                            Food Name (A–Z)
                        </option>

                        <option value="name_desc" <%= filters.sort === 'name_desc' ? 'selected' : '' %>>
                            Food Name (Z–A)
                        </option>

                        <option value="quantity_asc" <%= filters.sort === 'quantity_asc' ? 'selected' : '' %>>
                            Quantity (Lowest First)
                        </option>

                        <option value="quantity_desc" <%= filters.sort === 'quantity_desc' ? 'selected' : '' %>>
                            Quantity (Highest First)
                        </option>
                    </select>
                </div>

                <button class="button" type="submit">Apply Filters</button>
                <a class="button" href="/pantry">Clear Filters</a>
            </form>
        </section>

        <!-- Pantry items -->
        <section class="panel">
            <h2>Your Food Items</h2>

            <% if (items.length === 0) { %>
                <p class="empty">
                    No pantry items match your search or filters.
                    <a href="/pantry">View all pantry items</a>
                </p>
            <% } else { %>

                <p class="muted">
                    Showing <%= items.length %> pantry item(s).
                </p>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Food</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Purchase Date</th>
                                <th>Expiration Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% items.forEach(item => { %>
                                <%
                                    const today = new Date();

                                    const todayDate = new Date(
                                        today.getFullYear(),
                                        today.getMonth(),
                                        today.getDate()
                                    );

                                    const expirationDate = new Date(
                                        item.expiration_date.getFullYear(),
                                        item.expiration_date.getMonth(),
                                        item.expiration_date.getDate()
                                    );

                                    const daysRemaining = Math.round(
                                        (expirationDate - todayDate) /
                                        (1000 * 60 * 60 * 24)
                                    );

                                    let status;
                                    let statusClass;

                                    if (daysRemaining < 0) {
                                        status = 'EXPIRED';
                                        statusClass = 'status-expired';
                                    } else if (daysRemaining <= 7) {
                                        status = 'EXPIRING SOON';
                                        statusClass = 'status-expiring';
                                    } else {
                                        status = 'AVAILABLE';
                                        statusClass = 'status-available';
                                    }
                                %>

                                <tr>
                                    <td><%= item.name %></td>
                                    <td><%= item.category_name %></td>
                                    <td><%= item.quantity %></td>

                                    <td>
                                        <%= item.purchase_date.getFullYear() %>-<%= String(item.purchase_date.getMonth() + 1).padStart(2, '0') %>-<%= String(item.purchase_date.getDate()).padStart(2, '0') %>
                                    </td>

                                    <td>
                                        <%= item.expiration_date.getFullYear() %>-<%= String(item.expiration_date.getMonth() + 1).padStart(2, '0') %>-<%= String(item.expiration_date.getDate()).padStart(2, '0') %>
                                    </td>

                                    <td>
                                        <span class="status <%= statusClass %>">
                                            <%= status %>
                                        </span>
                                    </td>

                                    <td>
                                        <a href="/pantry/edit/<%= item.id %>">Edit</a>

                                        <form
                                            action="/pantry/delete/<%= item.id %>"
                                            method="POST"
                                            onsubmit="return confirm('Delete this pantry item?');"
                                        >
                                            <button class="button-danger" type="submit">
                                                Delete
                                            </button>
                                        </form>

                                        <form
                                            action="/pantry/consume/<%= item.id %>"
                                            method="POST"
                                        >
                                            <label for="quantity-<%= item.id %>">
                                                Consume quantity
                                            </label>

                                            <input
                                                type="number"
                                                id="quantity-<%= item.id %>"
                                                name="quantity"
                                                min="1"
                                                max="<%= item.quantity %>"
                                                value="1"
                                                required
                                            >

                                            <button type="submit">Consume</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            <% } %>
        </section>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>
