<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShelfLife - My Pantry</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('../partials/header') %>

    <main class="container">
        <section class="panel">
            <h1>My Pantry</h1>
            <p class="muted">Manage your food items and expiration dates.</p>

            <a class="button" href="/pantry/add">+ Add Food</a>
        </section>

        <section class="panel">
            <% if (items.length === 0) { %>
                <p class="empty">Your pantry is empty. Add a food item to get started.</p>
            <% } else { %>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Food</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Purchase Date</th>
                                <th>Expiration Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% items.forEach(item => { %>
                                <%
                                    const today = new Date();
                                    const todayDate = new Date(
                                        today.getFullYear(),
                                        today.getMonth(),
                                        today.getDate()
                                    );

                                    const expirationDate = new Date(
                                        item.expiration_date.getFullYear(),
                                        item.expiration_date.getMonth(),
                                        item.expiration_date.getDate()
                                    );

                                    const daysRemaining = Math.round(
                                        (expirationDate - todayDate) /
                                        (1000 * 60 * 60 * 24)
                                    );

                                    let status;
                                    let statusClass;

                                    if (daysRemaining < 0) {
                                        status = 'EXPIRED';
                                        statusClass = 'status-expired';
                                    } else if (daysRemaining <= 7) {
                                        status = 'EXPIRING SOON';
                                        statusClass = 'status-expiring';
                                    } else {
                                        status = 'AVAILABLE';
                                        statusClass = 'status-available';
                                    }
                                %>

                                <tr>
                                    <td><%= item.name %></td>
                                    <td><%= item.category_name %></td>
                                    <td><%= item.quantity %></td>

                                    <td>
                                        <%= item.purchase_date.getFullYear() %>-<%= String(item.purchase_date.getMonth() + 1).padStart(2, '0') %>-<%= String(item.purchase_date.getDate()).padStart(2, '0') %>
                                    </td>

                                    <td>
                                        <%= item.expiration_date.getFullYear() %>-<%= String(item.expiration_date.getMonth() + 1).padStart(2, '0') %>-<%= String(item.expiration_date.getDate()).padStart(2, '0') %>
                                    </td>

                                    <td>
                                        <span class="status <%= statusClass %>">
                                            <%= status %>
                                        </span>
                                    </td>

                                    <td>
                                        <a href="/pantry/edit/<%= item.id %>">Edit</a>

                                        <form
                                            action="/pantry/delete/<%= item.id %>"
                                            method="POST"
                                            onsubmit="return confirm('Delete this pantry item?');"
                                        >
                                            <button class="button-danger" type="submit">
                                                Delete
                                            </button>
                                        </form>

                                        <form action="/pantry/consume/<%= item.id %>" method="POST">
                                            <label for="quantity-<%= item.id %>">
                                                Consume quantity
                                            </label>

                                            <input
                                                type="number"
                                                id="quantity-<%= item.id %>"
                                                name="quantity"
                                                min="1"
                                                max="<%= item.quantity %>"
                                                value="1"
                                                required
                                            >

                                            <button type="submit">Consume</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            <% } %>
        </section>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>